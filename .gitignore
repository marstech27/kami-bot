# ── Dependencies ──────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Secrets & Env (NEVER PUSH THESE!) ─────────────────────
.env
.env.local
.env.*.local
config/service-account.json
config/*.json

# ── AWS SSH Keys (NEVER PUSH!) ─────────────────────────────
*.pem
*.ppk
kami-bot*.pem
nina*.pem
mykey*.pem

# ── WhatsApp Baileys Session (auth data) ──────────────────
# ⚠️  These are tied to the machine. If you re-deploy fresh,
#     you will need to scan the QR code again from panel.
auth_info/
sessionAuth/
*.session.json
baileys_auth/
baileys_sessions/

# ── Drive Cache (will be regenerated) ─────────────────────
.drive_cache.json
drive_cache.json

# ── Logs & Temp ───────────────────────────────────────────
logs/
*.log
pids/
*.pid
*.seed
tmp/
temp/

# ── PM2 / Process files ───────────────────────────────────
.pm2/
pm2-*.log
ecosystem.config.local.js

# ── OS / IDE ──────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
.Trashes

# ── Docker / Build artifacts ──────────────────────────────
dist/
build/
.cache/
coverage/

kami-bot-aws-key
kami-bot-aws-key.pub
*.pem
