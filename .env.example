# Bot owner / identity
OWNER_NUMBER=923417972691
BOT_NAME=Kami Bot
OWNER_NAME=Your Name

# Admin panel login (web dashboard)
PANEL_USER=admin
PANEL_PASS=admin

# Server
PORT=3000
APP_URL=http://localhost:3000

# ── Google Drive File System ─────────────────────────────
# Path to your service-account JSON key. Default: ./config/service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=./config/service-account.json

# The "shortcut hub" folder ID (from its Drive URL: drive.google.com/drive/folders/<THIS_ID>)
# This folder — and the real course folders it points to — MUST be shared
# with the service account's email (the "client_email" field in the JSON).
DRIVE_MAIN_FOLDER_ID=

# How many files .file / .more send per batch
DRIVE_BATCH_SIZE=5

# How many folder levels deep to search (Root > Dept > Course > Handouts = depth 3-4)
DRIVE_SEARCH_DEPTH=6
